DATABASE_URL=postgresql://shop_cafe:CHANGE_ME@127.0.0.1:5432/shop_cafe
# Neon deploy supplies the pooled URL above and this direct URL for migrations.
# Leave empty for local PostgreSQL; migrations then use DATABASE_URL.
DATABASE_URL_UNPOOLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_CURRENCY=VND
DEMO_VND_PER_USD=26000
AUTH_SECRET=GENERATE_A_LONG_RANDOM_SECRET
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
PASSWORD_SERVICE_URL=
PASSWORD_SERVICE_SECRET=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
UPLOAD_BUCKET=cafe-uploads
# Vercel: use custom names instead of the platform's reserved AWS_* names.
UPLOAD_S3_ENDPOINT=
UPLOAD_S3_ACCESS_KEY_ID=
UPLOAD_S3_SECRET_ACCESS_KEY=
UPLOAD_S3_REGION=us-east-2
SHOP_PICKUP_ADDRESS=Quầy Nhà Cà Phê (địa chỉ demo)
